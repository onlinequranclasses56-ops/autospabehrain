# ── Supabase (booking system + admin dashboard) ───────────────────────────────
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Admin panel credentials ───────────────────────────────────────────────────
# Set a strong password and a random session token (e.g. openssl rand -hex 32)
ADMIN_PASSWORD=change-me-strong-password
ADMIN_SESSION_TOKEN=change-me-random-32-char-token

# ── Optional: override the canonical site URL ─────────────────────────────────
# Vercel sets VERCEL_URL automatically; only set this if using a custom domain
# NEXT_PUBLIC_SITE_URL=https://autospabahrainwll.com
