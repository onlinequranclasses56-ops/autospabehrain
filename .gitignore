# ── Dependencies ──────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# ── Next.js build output ───────────────────────────────────────────────────────
/.next/
/out/

# ── TypeScript build artifacts ─────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Environment / secrets ──────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Vercel CLI ─────────────────────────────────────────────────────────────────
.vercel

# ── macOS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ── Debug / log files ─────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Test/QA artefacts (never commit) ──────────────────────────────────────────
qa-*.mjs
ss-*.png
screenshot-*.png
